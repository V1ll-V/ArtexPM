FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    wireguard-tools iproute2 iptables iputils-ping ca-certificates procps \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /etc/wireguard /run/wg

COPY docker/ctf-wg/entrypoint.sh /usr/local/bin/ctf-wg-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/ctf-wg-entrypoint && chmod 755 /usr/local/bin/ctf-wg-entrypoint

ENTRYPOINT ["/usr/local/bin/ctf-wg-entrypoint"]
